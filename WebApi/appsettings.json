{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=Shipping;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/full-log-.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlTable": true
          },
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "https://localhost:7210/",
    "Audience": "https://localhost:7210/",
    "Key": "ThisIsASecretKeyForJwt-ThatKeyMustBeLongWordBecouseTheIncryptonCanBeDoneWithIt=56",
    "DurationInMinutes": 15
  },
  "AllowedHosts": "*"
}