<!-- Tracking start -->
<div class="wshipping-content-block">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-6 offset-lg-3">
                <div class="section-title wow fadeInUp">
                    <h2>@ResFrontend.Lbl_TrackShipment</h2>
                    <p>@ResFrontend.Txt_TrackingDescription <span>@ResFrontend.Lbl_TrackNumber</span></p>
                </div>
            </div>
        </div>
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9">
                <div class="tracking-block">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item"><a class="nav-link active" href="#track-by-number" aria-controls="track-by-number" role="tab" data-toggle="tab">@ResFrontend.Lbl_TrackByNumber</a></li>
                        <li class="nav-item"><a class="nav-link" href="#track-by-reference" aria-controls="track-by-reference" role="tab" data-toggle="tab">@ResFrontend.Lbl_TrackByReference</a></li>
                    </ul>
                    <div class="tab-content">
                        <div role="tabpanel" class="tab-pane active" id="track-by-number">
                            <h3>@ResFrontend.Lbl_AirFreightTracking</h3>
                            <div class="put-track-number">
                                <form action="track.html">
                                    <input type="text" class="form-control track-id" name="trackid" placeholder="@ResFrontend.Plh_TrackId" />
                                    <button type="submit" class="btn btn-track">@ResFrontend.Btn_Track</button>
                                </form>
                            </div>
                            <div class="track-bottom-link"><a href="">@ResFrontend.Lbl_NeedHelp</a> <span>|</span> <a href="">@ResFrontend.Lbl_YourOrderList</a></div>
                        </div>
                        <div role="tabpanel" class="tab-pane" id="track-by-reference">
                            <div class="put-reference-number">
                                <form action="customer-register.html">
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-12 col-md-6 col-lg-4">
                                                <label>@ResFrontend.Lbl_ShipmentReference</label>
                                                <input type="text" class="form-control" name="RefNumber" required />
                                            </div>
                                            <div class="col-12 col-md-6 col-lg-4">
                                                <label>@ResFrontend.Lbl_ShipmentDateStart</label>
                                                <div class="input-group date" data-provide="datepicker">
                                                    <input type="text" class="form-control" name="startDate" required />
                                                    <div class="input-group-addon"><span class="glyphicon glyphicon-th"></span></div>
                                                </div>
                                            </div>
                                            <div class="col-12 col-md-6 col-lg-4">
                                                <label>@ResFrontend.Lbl_ShipmentDateEnd</label>
                                                <div class="input-group date" data-provide="datepicker">
                                                    <input type="text" class="form-control" name="EndDate" required />
                                                    <div class="input-group-addon"><span class="glyphicon glyphicon-th"></span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-12 col-md-6 col-lg-6">
                                                <label>@ResFrontend.Lbl_OriginCountry</label>
                                                <select class="form-control" name="OriginCountry">
                                                    <option>United State</option>
                                                    <option>Canada</option>
                                                    <option>Maxico</option>
                                                    <option>Caina</option>
                                                </select>
                                            </div>
                                            <div class="col-12 col-md-6 col-lg-6">
                                                <label>@ResFrontend.Lbl_OriginZipCode</label>
                                                <input type="text" class="form-control" name="OriginZip" required />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-12 col-md-6 col-lg-6">
                                                <label>@ResFrontend.Lbl_DestinationCountry</label>
                                                <select class="form-control" name="dcountry">
                                                    <option>United State</option>
                                                    <option>Canada</option>
                                                    <option>Maxico</option>
                                                    <option>Caina</option>
                                                </select>
                                            </div>
                                            <div class="col-12 col-md-6 col-lg-6">
                                                <label>@ResFrontend.Lbl_DestinationZipCode</label>
                                                <input type="text" class="form-control" name="DZip" required />
                                            </div>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-submit">@ResFrontend.Btn_Track</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Tracking end -->


