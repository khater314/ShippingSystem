@model UserLoginDto

<!-- Breadcroumbs start -->
<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <h1>@ResShared.Page_Title_CustomerLogin</h1>
                <a asp-action="Index" asp-controller="Home" title="@ResShared.Lbl_Home">@ResShared.Lbl_Home</a> / @ResShared.Page_Title_CustomerLogin
            </div>
            <div class="col-12 col-lg-5 text-right">
                <h4>
                    @ResShared.Msg_ShippingWorldwide
                    @ResShared.Msg_BestLogisticCompany, <span>@ResShared.Word_Fast</span> @ResShared.Msg_And <span>@ResShared.Word_Safely!</span>
                </h4>
            </div>
        </div>
    </div>
</div>
<!-- Breadcroumbs end -->
<!-- Customer login Start -->
<div class="wshipping-content-block">
    <div class="container">
        <div class="customer-login">
            <div class="row">
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="customer-login-left">
                        <div class="login-icon"><i class="fa fa-lock"></i></div>
                        <h4>@ResShared.Msg_WelcomeToYourAccount</h4>
                        <p>@ResShared.Msg_LoginDescription</p>
                        <a asp-action="Register" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl">@ResShared.Btn_CreateNewAccount</a>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="customer-login-block">
                        <h2>@ResShared.Page_Title_LoginToYourAccount</h2>
                        <form asp-action="Login" asp-controller="Account" method="post">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <input type="hidden" asp-for="ReturnUrl" />
                            
                            <div class="form-group">
                                <label asp-for="Email">@ResShared.Lbl_EmailAddress</label>
                                <input type="email" class="form-control" asp-for="Email" placeholder="@ResShared.Plh_Email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            
                            <div class="form-group">
                                <label asp-for="Password">@ResShared.Lbl_Password</label>
                                <input type="password" class="form-control" asp-for="Password" placeholder="@ResShared.Plh_Password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            
                            <div class="checkbox">
                                <input type="checkbox" name="RememberMe" id="remember" class="css-checkbox" asp-for="RememberMe" />
                                <label for="remember" class="css-label">@ResShared.Lbl_RememberMe</label>
                                <a asp-action="ForgotPassword" asp-controller="Account" title="" class="forgot-pass">@ResShared.Btn_ForgotPassword</a>
                            </div>
                            
                            <button type="submit" class="btn btn-submit">@ResShared.Btn_Login</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Customer login end -->