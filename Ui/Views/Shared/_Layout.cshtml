@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentCulture.TwoLetterISOLanguageName"
      dir="@(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8">
    <meta name="description" content="">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="keywords" content="Bootstrap4, Multipurpose, responsive, Business, template,Shipping, Cargo, logistic, html5, css, javascript, web24service" />
    <meta name="author" content="web24service">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>W-shipping - The World Class Bootstrap4 Multipurpose Shipping Cargo Logistic HTML5 Template</title>

    <link rel="shortcut icon" type="image/png" href="~/assets/images/fevicon.png">

    @if (CultureInfo.CurrentCulture.TextInfo.IsRightToLeft)
    {
        <link rel="stylesheet" href="~/assets/css/bootstrap.rtl.min.css">
    }
    else
    {
        <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    }

    <link rel="stylesheet" href="~/assets/css/fontawesome.all.min.css">
    <link rel="stylesheet" href="~/assets/css/animate.min.css">
    <link rel="stylesheet" href="~/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/assets/css/fancybox.min.css">
    <link rel="stylesheet" href="~/assets/css/chat.css">
    <link rel="stylesheet" href="~/assets/css/slicknav.min.css">
    <link rel="stylesheet" href="~/assets/css/bootstrap-datetimepicker.min.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/assets/css/responsive.css">

    @if (CultureInfo.CurrentCulture.TextInfo.IsRightToLeft)
    {
        <link rel="stylesheet" href="~/assets/css/rtl.css">
    }

    @* <script src="~/assets/js/jquery-3.4.1.min.js"></script> *@
</head>
<body>
    <div class="main-wrapper">

        <a id="skiptocontent" href="#maincontent">@ResFrontend.Lbl_SkipNavigation</a>

        <div class="wshipping-site-preloader-wrapper">
            <div class="spinner">
                <div class="double-bounce1"></div>
                <div class="double-bounce2"></div>
            </div>
        </div>

        <header class="for-sticky">
            <div class="header-top-area">
                <div class="container">
                    <div class="row">
                        <div class="col-12 col-lg-8">
                            <div class="top-contact">
                                <a href="#"><i class="fa fa-envelope"></i> info@company.com</a>
                                <a href="#"><i class="fa fa-phone"></i> +88 01xxx 8xxx04</a>
                                <a href="#"><i class="far fa-clock"></i> 9:00AM to 8:00PM</a>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4 d-flex justify-content-center justify-content-lg-end">
                            <div class="top-menu">
                                <ul>
                                    <li><a href="customer-login.html"><i class="fas fa-sign-in-alt"></i> @ResFrontend.Btn_Login</a></li>
                                    <li><a href="customer-register.html"><i class="fa fa-unlock-alt"></i> @ResFrontend.Btn_Registration</a></li>
                                </ul>
                            </div>
                            <div class="language">
                                <ul>
                                    <li>
                                        <a href="#" title="" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                                            <img src="~/assets/images/flag-1.png" alt="@ResFrontend.Alt_FlagEnglish" /> @ResFrontend.Lang_Code_EN
                                        </a>
                                        <ul class="dropdown-menu">
                                            <li><a href="" title=""><img src="~/assets/images/flag-1.png" alt="@ResFrontend.Alt_FlagEnglish" /> @ResFrontend.Lang_Code_EN</a></li>
                                            <li><a href="" title=""><img src="~/assets/images/flag-2.png" alt="@ResFrontend.Alt_FlagArabic" /> @ResFrontend.Lang_Code_AR</a></li>
                                        </ul>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="header-area">
                <div class="container">
                    <div class="logo">
                        <a href="index.html" title="W-shipping"><img src="~/assets/images/logo.png" alt="@ResFrontend.Alt_Logo" /></a>
                    </div>
                    <div class="mobile-menu-wrapper"></div>

                    <nav class="mainmenu">
                        <ul id="navigation">
                            <li class="nav-active"><a href="index.html">@ResFrontend.Menu_Home</a></li>
                            <li><a href="about.html">@ResFrontend.Menu_AboutUs</a></li>
                            <li><a href="services.html">@ResFrontend.Menu_Services</a></li>
                            <li><a href="shipment/create">@ResFrontend.Menu_Shipping</a></li>
                            <li><a href="blog.html">@ResFrontend.Menu_Blog</a></li>
                            <li><a href="contact.html">@ResFrontend.Menu_ContactUs</a></li>
                            <li><a href="profile.html"><img class="header-profile-pic" src="~/assets/images/profile.jpg" alt="@ResFrontend.Alt_ProfilePicture" /> @ResFrontend.Menu_Profile</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </header>

        @RenderBody()

        <footer class="site-footer">
            <div class="footer-top-area">
                <div class="container">
                    <div class="row">
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="footer-wiz">
                                <h3 class="footer-logo"><img src="~/assets/images/footer-logo.png" alt="@ResFrontend.Alt_FooterLogo" /></h3>
                                <p>It was popularised in the 1960s with the release of Letraset sheets containing.</p>
                                <ul class="footer-contact">
                                    <li><i class="fa fa-phone"></i> +88 01xxx 8xxx04</li>
                                    <li><i class="fa fa-envelope"></i> info@companyname.com</li>
                                    <li><i class="fa fa-fax"></i> +88 x2 1xx4x6</li>
                                </ul>
                            </div>
                            <div class="top-social bottom-social">
                                <a href="#"><i class="fab fa-facebook-f"></i></a>
                                <a href="#"><i class="fab fa-twitter"></i></a>
                                <a href="#"><i class="fab fa-youtube"></i></a>
                                <a href="#"><i class="fa fa-rss"></i></a>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="footer-wiz footer-menu">
                                <h3 class="footer-wiz-title">@ResFrontend.Lbl_FooterQuickLinks</h3>
                                <ul>
                                    <li><a href="about.html">@ResFrontend.Menu_CompanyOverview</a></li>
                                    <li><a href="services.html">@ResFrontend.Menu_OurServices</a></li>
                                    <li><a href="blog.html">@ResFrontend.Menu_Blog</a></li>
                                    <li><a href="contact.html">@ResFrontend.Menu_ContactUs</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="footer-wiz footer-menu">
                                <h3 class="footer-wiz-title">@ResFrontend.Lbl_FooterUsefulLinks</h3>
                                <ul>
                                    <li><a href="create-shipping.html">@ResFrontend.Menu_CreateShipping</a></li>
                                    <li><a href="tracking.html">@ResFrontend.Menu_Tracking</a></li>
                                    <li><a href="shipment-history.html">@ResFrontend.Menu_ShipmentHistory</a></li>
                                    <li><a href="tracking-result.html">@ResFrontend.Menu_TrackingResult</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <div class="footer-wiz">
                                <h3 class="footer-wiz-title">@ResFrontend.Lbl_FooterOpeningHours</h3>
                                <ul class="open-hours">
                                    <li><span>@ResFrontend.Lbl_MonToFri</span> <span class="text-right">09:30AM to 05:30PM</span></li>
                                    <li><span>@ResFrontend.Lbl_Sun</span> <span class="text-right">@ResFrontend.Lbl_Closed</span></li>
                                </ul>
                                <div class="newsletter">
                                    <form action="index.html">
                                        <input type="text" placeholder="@ResFrontend.Plh_NewsletterEmail" value="" class="news-input">
                                        <button type="submit" value="" class="news-btn"><i class="fa fa-location-arrow"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="footer-bottom-area">
                <div class="container">
                    <div class="row">
                        <div class="col-12 col-lg-6 wow fadeInLeft">Copyright © 2024 World shipping. All Rights Reserved</div>
                        <div class="col-12 col-lg-6 text-right wow fadeInRight">@ResFrontend.Lbl_DesignBy <a href="#" title="companytitle" target="_blank">Company Title</a></div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <div class="scrollup"><i class="fas fa-chevron-up"></i></div>

    <script src="~/assets/js/jquery-3.4.1.min.js"></script>
    <script src="~/assets/js/tether.min.js"></script>
    <script src="~/assets/js/popper.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/owl.carousel.min.js"></script>
    <script src="~/assets/js/datetimepicker-moment.min.js"></script>
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
    <script src="~/assets/js/jquery.slicknav.min.js"></script>
    <script src="~/assets/js/jquery.fancybox.min.js"></script>
    <script src="~/assets/js/wow-1.3.0.min.js"></script>
    <script src="~/assets/js/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/assets/js/form-step.js"></script>
    <script src="~/assets/js/youtube-background.js"></script>
    <script src="~/assets/js/jquery.filterizr.min.js"></script>
    <script src="~/assets/js/chat.js"></script>
    <script src="~/assets/js/coming-soon.js"></script>
    <script src="~/assets/js/active.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>