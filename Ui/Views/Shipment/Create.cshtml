    <script src="~/modules/services/cityservice.js"></script>
    <script src="~/modules/services/packagingservice.js"></script>
    <script src="~/modules/services/shippingtypeservice.js"></script>
    <script src="~/modules/utilities/dropdownhelper.js"></script>
    <script src="~/modules/services/shipment/shipmentservice.js"></script>
    <script src="~/Modules/Services/Shipment/Create.js"></script>
