@model UserRegisterDto

<!-- Breadcroumbs start -->
<div class="wshipping-content-block wshipping-breadcroumb inner-bg-1">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <h1>@ResShared.Page_Title_CustomerRegistration</h1>
                <a asp-action="Index" asp-controller="Home" title="@ResShared.Lbl_Home">@ResShared.Lbl_Home</a> / @ResShared.Page_Title_CustomerRegistration
            </div>
            <div class="col-12 col-lg-5 text-right">
                <h4>
                    @ResShared.Msg_ShippingWorldwide
                    @ResShared.Msg_BestLogisticCompany, <span>@ResShared.Word_Fast</span> @ResShared.Msg_And <span>@ResShared.Word_Safely!</span>
                </h4>
            </div>
        </div>
    </div>
</div>
<!-- Breadcroumbs end -->
<!-- Customer Registration Start -->
<div class="wshipping-content-block">
    <div class="container">
        <div class="customer-login">
            <div class="row">
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="customer-login-left">
                        <div class="login-icon"><i class="fa fa-unlock-alt"></i></div>
                        <h4>@ResShared.Msg_WelcomeToNewAccount</h4>
                        <p>@ResShared.Msg_RegistrationDescription</p>
                        <a asp-action="Login" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl">@ResShared.Msg_AlreadyHaveAccountLogin</a>
                    </div>
                </div>
                <div class="col-12 col-md-6 col-lg-6">
                    <div class="customer-login-block">
                        <h2>@ResShared.Page_Title_Registration</h2>
                        <form asp-action="Register" asp-controller="Account" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <input asp-for="ReturnUrl" type="hidden" />

                            <div class="form-group">
                                <div class="row">
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <label asp-for="FirstName">@ResShared.Lbl_FirstName</label>
                                        <input type="text" class="form-control" asp-for="FirstName" placeholder="@ResShared.Plh_FirstName" />
                                        <span asp-validation-for="FirstName" class="text-danger"></span>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <label asp-for="LastName">@ResShared.Lbl_LastName</label>
                                        <input type="text" class="form-control" asp-for="LastName" placeholder="@ResShared.Plh_LastName" />
                                        <span asp-validation-for="LastName" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="row">
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <label asp-for="Email">@ResShared.Lbl_EmailAddress</label>
                                        <input type="email" class="form-control" asp-for="Email" placeholder="@ResShared.Plh_Email" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <label asp-for="PhoneNumber">@ResShared.Lbl_Phone</label>
                                        <input type="text" class="form-control" asp-for="PhoneNumber" placeholder="@ResShared.Plh_Phone" />
                                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="row">
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <label asp-for="Password">@ResShared.Lbl_Password</label>
                                        <input type="password" class="form-control" asp-for="Password" placeholder="@ResShared.Plh_Password" />
                                        <span asp-validation-for="Password" class="text-danger"></span>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-6">
                                        <label asp-for="ConfirmedPassword">@ResShared.Lbl_ConfirmPassword</label>
                                        <input type="password" class="form-control" asp-for="ConfirmedPassword" placeholder="@ResShared.Plh_ConfirmPassword" />
                                        <span asp-validation-for="ConfirmedPassword" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-submit">@ResShared.Btn_Registration</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Customer Registration end -->

